model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(BUYER)
  fullName      String?
  phoneE164     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  status        AccountStatus  @default(PENDING)

  seller        SellerVerification?
  products      Product[]
  orders        Order[]        @relation("BuyerOrders")

  // Paired sides for Message relations (MUST exist)
  sentMessages     Message[]   @relation("SentMessages")
  receivedMessages Message[]   @relation("ReceivedMessages")

  @@index([role, status])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  fromUserId     String
  toUserId       String
  body           String
  createdAt      DateTime     @default(now())

  conversation  Conversation @relation(fields: [conversationId], references: [id])

  // Name each relation & pair to User arrays above
  fromUser      User         @relation("SentMessages",     fields: [fromUserId], references: [id])
  toUser        User         @relation("ReceivedMessages", fields: [toUserId],   references: [id])

  @@index([fromUserId])
  @@index([toUserId])
}
